# ==============================================================================
# WAYVORA - ENVIRONMENT SECRETS & CONFIGURATION
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - This file is a template (.env.example). Never commit real API keys to git.
# - Copy this file to .env and set your secrets.
# - The .env file is git-ignored and blocked from static serving by server.js.
# ==============================================================================

# Resend API Secret Key (REQUIRED for support email delivery)
# Obtain your API key from the Resend Dashboard: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_your_api_key_here

# Resend Sender Email Address
# Initial Testing Sandbox:
#   Use 'WAYVORA Support <onboarding@resend.dev>'
#   NOTE: With onboarding@resend.dev, Resend restricts delivery to your registered Resend account email.
# Production Deployment:
#   Verify your custom domain at https://resend.com/domains (e.g. support@wayvora.com)
RESEND_FROM_EMAIL=WAYVORA Support <onboarding@resend.dev>

# Administrator Notification Email
# Inquiries submitted by travelers will trigger an alert to this address.
# Replying to this email in your client automatically replies to the traveler.
ADMIN_EMAIL=wayvora.admin@gmail.com

# Optional Resend Sandbox Testing Email (Registered Resend Account Email)
# During sandbox testing, Resend only allows sending to the email registered with your Resend account.
# If set, test deliveries in sandbox mode will forward a copy to this address.
RESEND_TEST_EMAIL=wayvora.admin@gmail.com

# Optional External AI API Keys (Google Gemini / OpenAI)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ==============================================================================
# Google Cloud Gmail API OAuth2 Integration (Project: wayvora-gmail-integration)
# Minimum required scope: https://www.googleapis.com/auth/gmail.send
# Administrator Gmail Account: wayvora.admin@gmail.com
# ==============================================================================
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# OAuth Callback URL
# Local development:
GOOGLE_REDIRECT_URI=http://localhost:5500/api/auth/google/callback
# Production (set this in Vercel project environment variables):
# GOOGLE_REDIRECT_URI=https://wayvora-jade.vercel.app/api/auth/google/callback

# Administrator Gmail Account
ADMIN_GMAIL=wayvora.admin@gmail.com
