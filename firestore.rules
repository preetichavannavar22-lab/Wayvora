rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile and favorites: only authenticated user can read & write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Saved trips subcollection: only authenticated user can read & write their own trips
      match /trips/{tripId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
